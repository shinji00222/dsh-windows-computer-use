{
  "name": "dsh-windows-computer-use",
  "version": "0.1.0-preview.1",
  "private": true,
  "description": "DSH / DeepSeek Harness Windows computer-use plugin: screenshot, UI Automation, OCR, mouse, Chinese input and Esc stop.",
  "type": "module",
  "license": "MIT",
  "author": "shinji00222",
  "main": "dist/plugin.js",
  "exports": {
    ".": "./dist/plugin.js",
    "./client": "./dist/client.js"
  },
  "bin": {
    "dsh-windows-computer-use": "dist/server.js"
  },
  "files": [
    "dist",
    "native",
    "cordis.patch.yml",
    "LICENSE",
    "NOTICE.md",
    "README.md",
    "CHANGELOG.md",
    "技能.md",
    "docs/release-notes.md",
    "docs/verification.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:ts": "tsc -p tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run build && npm test",
    "package:local": "node scripts/package.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "os": [
    "win32"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "ajv": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-mcp-client": ">=0.2.0-rc.2",
    "@deepseek-ai/schemastery": ">=3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-mcp-client": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "bundleDependencies": [
    "@modelcontextprotocol/sdk",
    "ajv"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "computer-use",
    "windows",
    "desktop-automation",
    "mcp",
    "csharp",
    "typescript",
    "电脑控制"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shinji00222/dsh-windows-computer-use.git"
  },
  "homepage": "https://github.com/shinji00222/dsh-windows-computer-use#readme",
  "bugs": {
    "url": "https://github.com/shinji00222/dsh-windows-computer-use/issues"
  }
}
